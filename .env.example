# Monad Agent Hackathon Kit — Environment Variables

# ─── LLM Provider ───────────────────────────────────────────
# Options: openai | anthropic | openrouter
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# ─── API Keys (set at least one) ────────────────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# Sarvam AI — speech-to-text (₹100 free credits on signup)
# https://dashboard.sarvam.ai
SARVAM_API_KEY=

# OpenRouter optional
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=monad-agent-hackathon-kit

# ─── Backend ──────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ─── RAG ────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./datasets/chroma
EMBEDDING_MODEL=text-embedding-3-small
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ─── Frontend ─────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000

# ─── Monad Blockchain ─────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
MONAD_CHAIN_ID=10143
# NEVER commit real private keys — use testnet only
AGENT_WALLET_PRIVATE_KEY=
